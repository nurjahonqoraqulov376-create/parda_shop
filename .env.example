DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# Kontent saqlanganda uz -> ru avtomatik tarjima (Google, kalitsiz)
AUTO_TRANSLATE=True
AUTO_TRANSLATE_TIMEOUT=4.0

# --- Suhbat yordamchisi (Google Gemini, bepul tarif) ---
# Kalit: https://aistudio.google.com/apikey
# Kalit bo'sh bo'lsa AI o'chadi va mijoz to'g'ridan-to'g'ri operatorga ulanadi.
AI_SUPPORT=True
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Email (support xodimiga «jonli operator kerak» xabari) ---
# DEBUG=True bo'lsa xat konsolga chiqadi, SMTP kerak emas.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=sevara-design@example.com
# Xodim profilidagi emaildan tashqari qo'shimcha manzillar (vergul bilan)
SUPPORT_NOTIFY_EMAILS=
# Emaildagi havola to'liq bo'lishi uchun, masalan https://sevara.uz
SITE_BASE_URL=
